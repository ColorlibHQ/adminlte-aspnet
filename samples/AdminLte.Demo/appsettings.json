{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AdminLte": {
    "BrandText": "AdminLTE 4",
    "BrandUrl": "/",
    "SidebarTheme": "dark",
    "DefaultColorMode": "auto",
    "ColorModeToggle": true,
    "CommandPalette": true,
    "FooterText": "AdminLTE.io",
    "Menu": [
      { "Header": "MAIN NAVIGATION" },
      { "Text": "Dashboard", "Url": "/", "Icon": "bi bi-speedometer" },
      {
