@page "/login"
@layout EmptyLayout
@* Uses the AdminLTE AuthLayout instead of the dashboard shell. *@

<PageTitle>Sign in · AdminLTE 4 for ASP.NET Core</PageTitle>

<AuthLayout AuthType="login" Variant="v2" LogoHref="/">
    <p class="login-box-msg">Sign in to start your session</p>
    <EditForm Model="_model" OnValidSubmit="SignIn">
        <Input Type="email" @bind-Value="_model.Email" Placeholder="Email" Prepend="@@" />
        <Input Type="password" @bind-Value="_model.Password" Placeholder="Password" Append="🔒" />
        <div class="d-flex justify-content-between align-items-center mb-3">
            <InputSwitch Label="Remember me" @bind-Value="_model.Remember" />
            <a href="/" class="text-decoration-none">Forgot password?</a>
        </div>
        <Button Type="submit" Theme="primary" Block="true" Label="Sign in" />
    </EditForm>
    @if (_signedIn)
    {
        <div class="mt-3">
            <Alert Theme="success" Icon="bi-check-circle-fill">Signed in (demo).</Alert>
        </div>
    }
</AuthLayout>

@code {
    private LoginModel _model = new();
    private bool _signedIn;

    private void SignIn() => _signedIn = true;

    private sealed class LoginModel
    {
        public string? Email { get; set; }
        public string? Password { get; set; }
        public bool Remember { get; set; }
    }
}
