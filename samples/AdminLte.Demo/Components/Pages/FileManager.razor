@page "/file-manager"
@* File Manager — folder sidebar, storage meter and a file browser. A @code bool
   toggles between the grid and list views (pure Blazor state, no JS). *@

<PageTitle>File Manager · AdminLTE 4 for ASP.NET Core</PageTitle>

<AppContent Title="File Manager" Breadcrumbs="_breadcrumbs">
    <div class="row g-3">
        <!-- Folder tree -->
        <div class="col-lg-3">
            <div class="d-grid gap-2 mb-3">
                <button class="btn btn-primary" type="button">
                    <i class="bi bi-cloud-upload me-1" aria-hidden="true"></i>Upload files
                </button>
                <button class="btn btn-outline-secondary" type="button">
                    <i class="bi bi-folder-plus me-1" aria-hidden="true"></i>New folder
                </button>
            </div>
            <div class="card">
                <div class="list-group list-group-flush">
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center active">
                        <span><i class="bi bi-house me-2" aria-hidden="true"></i>My Drive</span>
                        <small class="opacity-75">24</small>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center ps-4">
                        <span><i class="bi bi-folder me-2" aria-hidden="true"></i>Documents</span>
                        <small class="opacity-75">12</small>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center ps-4 active">
                        <span><i class="bi bi-folder me-2" aria-hidden="true"></i>Design</span>
                        <small class="opacity-75">8</small>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center ps-5">
                        <span><i class="bi bi-folder me-2" aria-hidden="true"></i>v2.4 candidates</span>
                        <small class="opacity-75">4</small>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center ps-5">
                        <span><i class="bi bi-folder me-2" aria-hidden="true"></i>Archive</span>
                        <small class="opacity-75">28</small>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center ps-4">
                        <span><i class="bi bi-folder me-2" aria-hidden="true"></i>Invoices</span>
                        <small class="opacity-75">41</small>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-people me-2" aria-hidden="true"></i>Shared with me</span>
                        <small class="opacity-75">9</small>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-star me-2" aria-hidden="true"></i>Starred</span>
                        <small class="opacity-75">6</small>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-clock-history me-2" aria-hidden="true"></i>Recent</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-trash me-2" aria-hidden="true"></i>Trash</span>
                        <small class="opacity-75">3</small>
                    </a>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-body">
                    <p class="fw-semibold mb-2 small">
                        <i class="bi bi-cloud me-1" aria-hidden="true"></i>Storage
                    </p>
                    <div class="progress mb-2" style="height: 8px">
                        <div class="progress-bar" role="progressbar" style="width: 62%"
                             aria-valuenow="62" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <small class="text-secondary">6.2 GB of 10 GB used</small>
                </div>
            </div>
        </div>

        <!-- File browser -->
        <div class="col-lg-9">
            <Card>
                <HeaderContent>
                    <div class="d-flex flex-wrap gap-2 align-items-center w-100">
                        <nav aria-label="breadcrumb" class="flex-grow-1">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="#"><i class="bi bi-house" aria-hidden="true"></i></a></li>
                                <li class="breadcrumb-item"><a href="#">My Drive</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Design</li>
                            </ol>
                        </nav>
                        <div class="input-group input-group-sm" style="width: 14rem">
                            <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                            <input type="search" class="form-control" placeholder="Search files…" aria-label="Search files" />
                        </div>
                        <div class="btn-group btn-group-sm" role="group" aria-label="View">
                            <button type="button" class="btn @(_grid ? "btn-secondary" : "btn-outline-secondary")"
                                    @onclick="() => _grid = true" aria-pressed="@_grid" title="Grid view">
                                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn @(!_grid ? "btn-secondary" : "btn-outline-secondary")"
                                    @onclick="() => _grid = false" aria-pressed="@(!_grid)" title="List view">
                                <i class="bi bi-list-ul" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </HeaderContent>
                <ChildContent>
                    @if (_grid)
                    {
                        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                            @foreach (var f in _files)
                            {
                                <div class="col">
                                    <a href="#" class="card text-center text-decoration-none text-body h-100 position-relative">
                                        @if (f.Shared)
                                        {
                                            <span class="badge text-bg-info position-absolute top-0 end-0 m-2">
                                                <i class="bi bi-people-fill me-1" aria-hidden="true"></i>Shared
                                            </span>
                                        }
                                        <div class="card-body d-flex flex-column justify-content-center pb-2">
                                            <i class="bi @f.Icon @f.IconColor display-5 mb-3" aria-hidden="true"></i>
                                            <p class="card-title fw-medium small text-break mb-0">@f.Name</p>
                                        </div>
                                        <div class="card-footer bg-transparent small text-secondary py-2">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span class="text-truncate" title="@f.SizeLabel">
                                                    @if (f.IsFolder)
                                                    {
                                                        <i class="bi bi-folder me-1" aria-hidden="true"></i>
                                                    }
                                                    @f.SizeLabel
                                                </span>
                                                <span class="text-truncate" title="@f.Modified">@f.Modified</span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Size</th>
                                        <th>Modified</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in _files)
                                    {
                                        <tr>
                                            <td>
                                                <i class="bi @f.Icon @f.IconColor me-2" aria-hidden="true"></i>
                                                @f.Name
                                                @if (f.Shared)
                                                {
                                                    <span class="badge text-bg-info ms-2">Shared</span>
                                                }
                                            </td>
                                            <td>@(f.IsFolder ? "—" : f.SizeLabel)</td>
                                            <td>@f.Modified</td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-secondary" type="button" title="Download">
                                                        <i class="bi bi-download" aria-hidden="true"></i>
                                                    </button>
                                                    <button class="btn btn-outline-secondary" type="button" title="Share">
                                                        <i class="bi bi-share" aria-hidden="true"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" type="button" title="Delete">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </ChildContent>
                <FooterContent>
                    <span class="text-secondary small">@_files.Count items</span>
                </FooterContent>
            </Card>
        </div>
    </div>
</AppContent>

@code {
    private readonly IReadOnlyList<Breadcrumb.Crumb> _breadcrumbs =
        [new("Home", "/"), new("Pages"), new("Files")];

    private bool _grid = true;

    private sealed record FileItem(string Name, string Icon, string IconColor, string SizeLabel,
        string Modified, bool IsFolder, bool Shared);

    private readonly IReadOnlyList<FileItem> _files =
    [
        new("Customer interviews", "bi-folder-fill", "text-warning", "Folder", "Today", true, false),
        new("Q2 planning", "bi-folder-fill", "text-warning", "Folder", "Yesterday", true, true),
        new("design-review.pdf", "bi-file-earmark-pdf-fill", "text-danger", "1.4 MB", "10:42 AM", false, false),
        new("focus-ring-dark.png", "bi-file-earmark-image-fill", "text-primary", "320 KB", "10:38 AM", false, false),
        new("INV-2026-00428.pdf", "bi-file-earmark-pdf-fill", "text-danger", "184 KB", "Yesterday", false, false),
        new("roadmap.docx", "bi-file-earmark-word-fill", "text-info", "47 KB", "Yesterday", false, true),
        new("analytics-may.xlsx", "bi-file-earmark-spreadsheet-fill", "text-success", "92 KB", "May 16", false, false),
        new("site-export-2026-05.zip", "bi-file-earmark-zip-fill", "text-secondary", "12.3 MB", "May 14", false, false),
        new("main.tsx", "bi-file-earmark-code-fill", "text-primary", "8 KB", "May 12", false, false),
    ];
}
