@page "/login-v2"
@layout EmptyLayout
@* Uses the AdminLTE AuthLayout (v2: logo inside the card header). *@

<PageTitle>Sign in v2 · AdminLTE 4 for ASP.NET Core</PageTitle>

<AuthLayout AuthType="login" Variant="v2" LogoHref="/">
    <p class="login-box-msg">Sign in to start your session</p>
    <EditForm Model="_model" OnValidSubmit="SignIn">
        <Input Type="email" @bind-Value="_model.Email" Placeholder="Email" Append="@@" />
        <Input Type="password" @bind-Value="_model.Password" Placeholder="Password" Append="🔒" />
        <div class="row">
            <div class="col-8 d-inline-flex align-items-center">
                <InputSwitch Label="Remember Me" @bind-Value="_model.Remember" />
            </div>
            <div class="col-4">
                <Button Type="submit" Theme="primary" Block="true" Label="Sign In" />
            </div>
        </div>
    </EditForm>

    <div class="social-auth-links text-center mb-3 d-grid gap-2">
        <p>- OR -</p>
        <a href="#" class="btn btn-primary">
            <i class="bi bi-facebook me-2"></i> Sign in using Facebook
        </a>
        <a href="#" class="btn btn-danger">
            <i class="bi bi-google me-2"></i> Sign in using Google+
        </a>
    </div>

    <p class="mb-1">
        <a href="/" class="text-decoration-none">I forgot my password</a>
    </p>
    <p class="mb-0">
        <a href="/register" class="text-center text-decoration-none">Register a new membership</a>
    </p>

    @if (_signedIn)
    {
        <div class="mt-3">
            <Alert Theme="success" Icon="bi-check-circle-fill">Signed in (demo).</Alert>
        </div>
    }
</AuthLayout>

@code {
    private LoginModel _model = new();
    private bool _signedIn;

    private void SignIn() => _signedIn = true;

    private sealed class LoginModel
    {
        public string? Email { get; set; }
        public string? Password { get; set; }
        public bool Remember { get; set; }
    }
}
