@page "/register"
@layout EmptyLayout
@* Uses the AdminLTE AuthLayout instead of the dashboard shell. *@

<PageTitle>Register · AdminLTE 4 for ASP.NET Core</PageTitle>

<AuthLayout AuthType="register" Variant="default" LogoHref="/">
    <p class="register-box-msg">Register a new membership</p>
    <EditForm Model="_model" OnValidSubmit="SignUp">
        <Input @bind-Value="_model.FullName" Placeholder="Full Name" Append="👤" />
        <Input Type="email" @bind-Value="_model.Email" Placeholder="Email" Append="@@" />
        <Input Type="password" @bind-Value="_model.Password" Placeholder="Password" Append="🔒" />
        <div class="row">
            <div class="col-8">
                <InputSwitch Label="I agree to the terms" @bind-Value="_model.AgreeTerms" />
            </div>
            <div class="col-4">
                <Button Type="submit" Theme="primary" Block="true" Label="Register" />
            </div>
        </div>
    </EditForm>

    <div class="social-auth-links text-center mb-3 d-grid gap-2">
        <p>- OR -</p>
        <a href="#" class="btn btn-primary">
            <i class="bi bi-facebook me-2"></i> Sign in using Facebook
        </a>
        <a href="#" class="btn btn-danger">
            <i class="bi bi-google me-2"></i> Sign in using Google+
        </a>
    </div>

    <p class="mb-0">
        <a href="/login" class="text-center text-decoration-none">I already have a membership</a>
    </p>

    @if (_registered)
    {
        <div class="mt-3">
            <Alert Theme="success" Icon="bi-check-circle-fill">Registered (demo).</Alert>
        </div>
    }
</AuthLayout>

@code {
    private RegisterModel _model = new();
    private bool _registered;

    private void SignUp() => _registered = true;

    private sealed class RegisterModel
    {
        public string? FullName { get; set; }
        public string? Email { get; set; }
        public string? Password { get; set; }
        public bool AgreeTerms { get; set; }
    }
}
