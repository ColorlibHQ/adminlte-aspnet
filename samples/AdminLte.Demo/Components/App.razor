@* Root HTML document. Loads AdminLTE styles/scripts from the RCL static web assets. *@
@using ColorlibHQ.AdminLTE.AspNetCore.Components
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <title>AdminLTE 4 for ASP.NET Core</title>

    @* Bootstrap + AdminLTE CSS + no-flash color-mode script, from the RCL. *@
    <AdminLteStyles />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AdminLte.Demo.styles.css"]" />

    @* Plugin CSS for the JS-plugin demo pages (FullCalendar ships its CSS in its JS bundle). *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap@1.7.0/dist/jsvectormap.min.css">

    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <Routes @rendermode="InteractiveServer" />

    <script src="_framework/blazor.web.js"></script>
    @* Bootstrap bundle + AdminLTE JS, from the RCL. *@
    <AdminLteScripts />

    @* CDN plugin libraries + the demo interop module for the JS-plugin pages. *@
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.7/Sortable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsvectormap@1.7.0/dist/jsvectormap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsvectormap@1.7.0/dist/maps/world.js"></script>
    <script src="js/demo-interop.js"></script>
</body>
</html>
