@* A single tab pane. Must be a child of <Tabs>. *@

@code {
    /// <summary>Unique tab id (used for the active selection).</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    /// <summary>Tab button label.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Optional Bootstrap Icons class for the tab button.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Disable the tab button.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Tab pane content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private Tabs? Parent { get; set; }

    protected override void OnInitialized()
    {
        if (Parent is null)
            throw new InvalidOperationException($"<{nameof(Tab)}> must be used inside <{nameof(Tabs)}>.");

        Parent.Register(new Tabs.TabMeta
        {
            Id = Id,
            Title = Title,
            Icon = Icon,
            Disabled = Disabled,
            Content = ChildContent,
        });
    }
}
