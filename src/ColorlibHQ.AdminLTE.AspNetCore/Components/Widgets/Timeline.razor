@* AdminLTE timeline. *@
<div class="timeline">
    @foreach (var item in Items)
    {
        <div>
            <i class="bi @(string.IsNullOrEmpty(item.Icon) ? "bi-clock" : item.Icon) bg-@(item.IconTheme ?? "primary")"></i>
            <div class="timeline-item">
                @if (!string.IsNullOrEmpty(item.Time))
                {
                    <span class="time"><i class="bi bi-clock"></i> @item.Time</span>
                }
                <h3 class="timeline-header">
                    @if (!string.IsNullOrEmpty(item.Url))
                    {
                        <a href="@item.Url">@item.Title</a>
                    }
                    else
                    {
                        @item.Title
                    }
                </h3>
                @if (!string.IsNullOrEmpty(item.Body))
                {
                    <div class="timeline-body">@item.Body</div>
                }
                @if (!string.IsNullOrEmpty(item.Footer))
                {
                    <div class="timeline-footer">@item.Footer</div>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>One timeline entry.</summary>
    public sealed class Entry
    {
        public string? Time { get; set; }
        public string? Icon { get; set; }
        public string? IconTheme { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? Url { get; set; }
        public string? Body { get; set; }
        public string? Footer { get; set; }
    }

    /// <summary>The timeline entries, newest first.</summary>
    [Parameter] public IReadOnlyList<Entry> Items { get; set; } = Array.Empty<Entry>();
}
