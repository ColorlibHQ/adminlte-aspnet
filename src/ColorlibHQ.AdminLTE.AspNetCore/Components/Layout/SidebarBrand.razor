@* The sidebar logo / brand row. *@

<div class="sidebar-brand">
    <a href="@Href" class="brand-link">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrEmpty(LogoImage))
        {
            <img src="@LogoImage" alt="@BrandText" class="brand-image opacity-75 shadow" />
            <span class="brand-text fw-light">@BrandText</span>
        }
        else
        {
            <span class="brand-image opacity-75 shadow"></span>
            <span class="brand-text fw-light">@BrandText</span>
        }
    </a>
</div>

@code {
    /// <summary>Where the brand links to.</summary>
    [Parameter] public string Href { get; set; } = "/";

    /// <summary>Optional logo image URL.</summary>
    [Parameter] public string? LogoImage { get; set; }

    /// <summary>Brand text shown beside the logo.</summary>
    [Parameter] public string BrandText { get; set; } = "AdminLTE 4";

    /// <summary>Override the entire brand contents.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
