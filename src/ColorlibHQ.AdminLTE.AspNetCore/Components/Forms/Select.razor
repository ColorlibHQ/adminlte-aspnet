@* Labeled native select. Supports @bind-Value. *@
<div class="mb-3 @GroupClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@InputId" class="form-label">@Label</label>
    }
    <select id="@InputId" class="form-select @(string.IsNullOrEmpty(Error) ? null : "is-invalid")"
            value="@Value" @onchange="OnChange" disabled="@Disabled" @attributes="AdditionalAttributes">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (Options is not null)
        {
            @foreach (var opt in Options)
            {
                <option value="@opt.Value">@opt.Label</option>
            }
        }
    </select>
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="invalid-feedback d-block">@Error</div>
    }
</div>

@code {
    /// <summary>An option for the select.</summary>
    public sealed record Option(string Value, string Label);

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Id { get; set; }

    /// <summary>Options collection (alternative to child <c>&lt;option&gt;</c> markup).</summary>
    [Parameter] public IReadOnlyList<Option>? Options { get; set; }

    /// <summary>Bound value.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Two-way binding callback (<c>@bind-Value</c>).</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? Error { get; set; }
    [Parameter] public string? GroupClass { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Custom <c>&lt;option&gt;</c> markup (overrides <see cref="Options"/>).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string InputId => Id ?? $"sel-{GetHashCode():x}";

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
