<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <RazorLanguageVersion>10.0</RazorLanguageVersion>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>ColorlibHQ.AdminLTE.AspNetCore</PackageId>
    <Version>0.3.1</Version>
    <Authors>Colorlib</Authors>
    <Company>Colorlib</Company>
    <Product>AdminLTE 4 for ASP.NET Core</Product>
    <Title>AdminLTE 4 for ASP.NET Core (Blazor + MVC/Razor Pages)</Title>
    <Description>The official AdminLTE 4 admin dashboard template for ASP.NET Core. Ships Blazor components and Tag Helpers for MVC/Razor Pages, plus the compiled AdminLTE/Bootstrap 5.3 static web assets — a config-driven sidebar, dark mode, cards, small boxes, and more. Built on Bootstrap 5.3 with vanilla JS (no jQuery).</Description>
    <PackageTags>adminlte;bootstrap;blazor;aspnetcore;razor;tag-helpers;dashboard;admin;template;ui;mvc;razor-pages;bootstrap5</PackageTags>
    <PackageProjectUrl>https://github.com/ColorlibHQ/adminlte-aspnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ColorlibHQ/adminlte-aspnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <!-- Drop a 128x128 docs/icon.png to brand the package; auto-included when present. -->
    <PackageIcon Condition="Exists('..\..\docs\icon.png')">icon.png</PackageIcon>
    <Copyright>Copyright (c) 2014-2026 Colorlib</Copyright>
    <PackageReleaseNotes>Package page now renders correctly: ships a Markdown-only README (nuget.org escapes raw HTML). No code changes from 0.3.0.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Pack the README and icon into the NuGet package root -->
  <ItemGroup>
    <!-- NuGet renders a Markdown subset and escapes raw HTML, so the GitHub
         README's centred <p>/<div> blocks printed as literal text on the
         package page. NUGET.md is the same content in plain Markdown with
         absolute URLs; README.md stays rich for GitHub. -->
    <None Include="..\..\NUGET.md" Pack="true" PackagePath="\" Condition="Exists('..\..\NUGET.md')" />
    <None Include="..\..\docs\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\docs\icon.png')" />
  </ItemGroup>

</Project>
